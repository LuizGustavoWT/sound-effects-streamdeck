p='crates/streamdeck-ffi/src/main.rs'
s=open(p).read()

# 1. Adiciona PathBuf aos imports
if 'use std::path::PathBuf;' not in s:
    s = s.replace('use soundbar_core::config::Config;',
                  'use soundbar_core::config::Config;\nuse std::path::PathBuf;')

# 2. Corrige let chains (Rust 2021 não suporta)
# which_picker
old_picker = '''fn which_picker() -> Option<String> {
    for cand in ["zenity", "kdialog", "yad"] {
        if let Ok(p) = std::process::Command::new(cand).arg("--version").output()
            && p.status.success()
        {
            return Some(cand.to_string());
        }
    }
    // Fallback: nosso script GTK, que ja esta no repositorio.
    let local = scripts_dir().map(|d| d.join("soundbar_picker.py"));
    if let Some(p) = local
        && p.is_file()
    {
        return Some(p.display().to_string());
    }
    None
}'''
new_picker = '''fn which_picker() -> Option<String> {
    for cand in ["zenity", "kdialog", "yad"] {
        if let Ok(p) = std::process::Command::new(cand).arg("--version").output() {
            if p.status.success() {
                return Some(cand.to_string());
            }
        }
    }
    // Fallback: nosso script GTK, que ja esta no repositorio.
    if let Some(local) = scripts_dir().map(|d| d.join("soundbar_picker.py")) {
        if local.is_file() {
            return Some(local.display().to_string());
        }
    }
    None
}'''
if old_picker in s:
    s = s.replace(old_picker, new_picker)

# sounds_dir
old_sounds = '''fn sounds_dir(config_dir: &std::path::Path) -> Result<PathBuf> {
    if let Ok(cfg) = Config::load_dir(config_dir)
        && let Some(d) = cfg.sounds_dir
    {
        return Ok(d);
    }
    Ok(config_dir.join("sounds"))
}'''
new_sounds = '''fn sounds_dir(config_dir: &std::path::Path) -> Result<PathBuf> {
    if let Ok(cfg) = Config::load_dir(config_dir) {
        if let Some(d) = cfg.sounds_dir {
            return Ok(d);
        }
    }
    Ok(config_dir.join("sounds"))
}'''
if old_sounds in s:
    s = s.replace(old_sounds, new_sounds)

open(p,'w').write(s)
print("erros corrigidos")
