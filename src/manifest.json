{
	"Name": "Sound Effects Stream Deck",
	"Description": "Transforma o Stream Deck em uma soundbar de efeitos para live e gravacao.",
	"Author": "LuizGustavoWT",
	"Version": "0.1.0",
	"PluginUUID": "com.soundbar.streamdeck",
	"CodePathLin": "soundbar-plugin",
	"Icon": "assets/icon",
	"Category": "Sound Effects",
	"OS": [
		{
			"Platform": "linux"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "11"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Actions": [
		{
			"Name": "Play Effect",
			"UUID": "com.soundbar.play",
			"Icon": "assets/play",
			"States": [
				{
					"Image": "assets/play-idle",
					"TitleAlignment": "bottom",
					"TitleColor": "#FFFFFF",
					"FontSize": "12"
				},
				{
					"Image": "assets/play-active",
					"TitleAlignment": "bottom",
					"TitleColor": "#FFFFFF",
					"FontSize": "12"
				}
			],
			"Controllers": ["Keypad", "Encoder"],
			"SupportedInMultiActions": true,
			"Tooltip": "Soltar efeito sonoro no meio da live",
			"PropertyInspectorPath": "propertyInspector/play.html"
		},
		{
			"Name": "Stop All",
			"UUID": "com.soundbar.stopall",
			"Icon": "assets/stop",
			"States": [
				{
					"Image": "assets/stop"
				}
			],
			"Controllers": ["Keypad", "Encoder"],
			"SupportedInMultiActions": true,
			"Tooltip": "Parar todos os efeitos",
			"PropertyInspectorPath": "propertyInspector/none.html"
		}
	]
}
